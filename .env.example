# ===========================================================
# Purple Glow Social 2.0 — Environment Variables
# ===========================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ===========================================================

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Authentication (Better-auth) ---
BETTER_AUTH_SECRET="generate-a-secure-random-string-here"
BETTER_AUTH_URL="http://localhost:3000"

# --- OAuth providers (user login) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Social platform OAuth (posting & management) ---
# Meta (Facebook + Instagram + WhatsApp)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Twitter / X
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- App URL (used for OAuth redirect URIs) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Encryption (AES-256-GCM for OAuth tokens) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# --- Polar.sh (subscription billing) ---
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""

# --- AI Generation (OpenRouter) ---
OPENROUTER_API_KEY=""
